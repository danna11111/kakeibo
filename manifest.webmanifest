{
  "name": "わが家の家計簿",
  "short_name": "家計簿",
  "description": "記帳・固定費とサブスクの自動記帳・レシート読み取りができる自分専用の家計簿",
  "lang": "ja",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef1f0",
  "theme_color": "#1f6f6a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "image", "accept": ["image/*", "image/jpeg", "image/png", "image/webp", "image/heic"] }]
    }
  }
}
